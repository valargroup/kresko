# Local Zakura overrides for co-development.
# Copy this file to .cargo/config.toml and adjust each path.
# Remove .cargo/config.toml to use the Git revisions in Cargo.toml.
[patch."https://github.com/zakura-core/zakura.git"]
zakura-chain = { path = "../zakura/crates/zakura-chain" }
zakura = { path = "../zakura/crates/zakurad" }
zakura-jsonl-trace = { path = "../zakura/crates/zakura-jsonl-trace" }
